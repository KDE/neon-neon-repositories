fi

if [ ! -e /etc/apt/sources.list.d/org.kde.neon.packages.mozilla.org.sources ]; then
   cat << EOF > /etc/apt/sources.list.d/org.kde.neon.packages.mozilla.org.sources
X-Repolib-Name: KDE neon org.kde.neon.packages.mozilla.org
Types: deb
URIs: https://packages.mozilla.org/apt
Suites: mozilla
Components: main
Signed-By: /etc/apt/keyring/org.kde.neon.packages.mozilla.org.asc
EOF
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
