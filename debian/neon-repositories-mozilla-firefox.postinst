#!/bin/sh
# SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
# SPDX-FileCopyrightText: 2020-2022 Harald Sitter <sitter@kde.org>

set -ex

. /etc/os-release

if [ ! -e /etc/apt/sources.list.d/org.kde.neon.packages.mozilla.org.sources ]; then
   cat << EOF > /etc/apt/sources.list.d/org.kde.neon.packages.mozilla.org.sources
X-Repolib-Name: KDE neon org.kde.neon.packages.mozilla.org
Types: deb
URIs: https://packages.mozilla.org/apt
Suites: mozilla
Components: main
Signed-By: /etc/apt/keyrings/org.kde.neon.packages.mozilla.org.asc
EOF
fi

JOB_NAME=${JOB_NAME:="unset"}

# Refresh the cache if it doesn't already contain the repo. This appears to be doable since updates
# don't claim the lock. Whether it's sane to do is another question entirely...
if ! apt-get indextargets | grep --quiet --extended-regexp '^Repo-URI:.+packages.mozilla.org' && [ "$JOB_NAME" != "mgmt_daily_promotion_jammy_release" ]; then
  apt-get update || true # don't crap out on errors here
fi

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

exit 0
