set -ex

. /etc/os-release

# Earlier versions of this package had a postrm which would always rm these two files even on upgrade
# So check and add back their contents

if [ ! -e /etc/apt/preferences.d/org-kde-neon-net-packages-mozilla-org-pin ]; then
   cat << EOF > /etc/apt/preferences.d/org-kde-neon-packages-mozilla-org-pin
# SPDX-License-Identifier: GPL-2.0-only OR GPL-3.0-only OR LicenseRef-KDE-Accepted-GPL
# SPDX-FileCopyrightText: 2022 Harald Sitter <sitter@kde.org>

Package: firefox
Pin: origin packages.mozilla.org
Pin-Priority: 1000
EOF
fi

if [ ! -e  /etc/apt/keyring/org.kde.neon.packages.mozilla.org.asc ]; then
   cat << EOF >  /etc/apt/keyring/org.kde.neon.packages.mozilla.org.asc
-----BEGIN PGP PUBLIC KEY BLOCK-----

